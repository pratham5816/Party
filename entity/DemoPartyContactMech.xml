<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">

    <entity entity-name="DemoPartyContactMech" package-name="demo">
        <field name="partyId" type="id"/>
        <field name="contactMechId" type="id"/>
        <field name="fromDate" type="date-time"/>
        <field name="thruDate" type="date-time"/>

<!--        primary key of partyId +  contactMechId  + fromDate -->

        <primary-key field="partyId"/>
        <primary-key field="contactMechId"/>
        <primary-key field="fromDate"/>

<!-- DemoPartyContactMech.partyId  →  Party.partyId  -->
        <relationship type="one" related="demo.DemoParty" title="Party">
            <key-map field-name="partyId"/>
        </relationship>

        <relationship type="one" related="demo.DemoContactMech" title="Contact">
            <key-map field-name="contactMechId"/>
        </relationship>

    </entity>

</entities>