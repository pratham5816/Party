<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/entity-definition-3.xsd">
<entity entity-name="DemoParty" package-name="demo">
    <field name="partyId" type="id" is-pk="true"/>
    <field name="createdDate" type="date-time"/>
   <field name="partyTypeIdEnum" type="id"/>   <!-- enum field  -->

    <relationship type="one" title="PartyType" related="moqui.basic.Enumeration">
        <key-map field-name="partyTypeIdEnum" related-field-name="enumId"/>
        <entity-condition>
            <econdition field-name="enumTypeId" value="PartyType"/>
        </entity-condition>
    </relationship>
</entity>
</entities>