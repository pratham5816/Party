<?xml version="1.0" encoding="UTF-8"?>
<resource xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/rest-api-3.xsd"
          name="automobile" version="1.0" require-authentication="anonymous-all">
    <resource name="bikes">
        <method type="post">
            <service name="AutomobileService.create#Bike"/>
        </method>
        <resource name="{id}">
            <method type="delete">
                <service name="AutomobileService.delete#Bike"/>
            </method>
            <method type="put">
                <service name="AutomobileService.update#Bike"/>
            </method>
        </resource>
    </resource>
</resource>